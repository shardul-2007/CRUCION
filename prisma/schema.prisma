// Prisma Schema for CRUCION — Universal Software Engineering Ecosystem
// Enterprise PostgreSQL Database Storage

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum OrgPlan {
  FREE
  PRO
  ENTERPRISE
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ProjectRole {
  LEAD
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  BUILDING
  DEPLOYED
  IDLE
  ERROR
}

enum ProjectHealth {
  OPTIMAL
  DEGRADED
  STANDBY
}

enum IntegrationProvider {
  OPENAI
  ANTHROPIC
  GOOGLE_GEMINI
  OPENROUTER
  OLLAMA
  GITHUB
  VERCEL
  ANTIGRAVITY
  CUSTOM
}

enum IntegrationStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

enum AgentStatus {
  RUNNING
  IDLE
  EXECUTING_TOOL
  COMPLETED
  ERROR
}

enum DeploymentStatus {
  LIVE
  ROLLING_UPDATE
  CANARY
  FAILED
}

// -------------------------------------------------------------
// USER & IDENTITY
// -------------------------------------------------------------
model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  name                    String
  passwordHash            String
  role                    UserRole  @default(USER)
  avatarInitials          String?
  avatarUrl               String?
  emailVerified           Boolean   @default(false)
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  resetToken              String?   @unique
  resetTokenExpiry        DateTime?
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  lastLoginAt             DateTime?

  // Relations
  sessions                Session[]
  organizationMemberships OrganizationMember[]
  projectMemberships      ProjectMember[]
  ownedProjects           Project[]            @relation("ProjectOwner")
  integrations            Integration[]
  auditLogs               AuditLog[]
  agentRuns               AgentRun[]

  @@index([email])
}

// -------------------------------------------------------------
// SESSION MANAGEMENT
// -------------------------------------------------------------
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// -------------------------------------------------------------
// ORGANIZATIONS & TENANCY
// -------------------------------------------------------------
model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  plan        OrgPlan              @default(PRO)
  logoUrl     String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relations
  members     OrganizationMember[]
  projects    Project[]
  auditLogs   AuditLog[]
  integrations Integration[]

  @@index([slug])
}

model OrganizationMember {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedEmail   String?
  role           OrgRole       @default(MEMBER)
  status         MemberStatus  @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([invitedEmail])
}

// -------------------------------------------------------------
// PROJECTS & WORKSPACES
// -------------------------------------------------------------
model Project {
  id               String        @id @default(cuid())
  name             String
  slug             String
  description      String?
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  containerRuntime String        @default("Node 24 / V8")
  gitRepoUrl       String?
  gitBranch        String        @default("main")
  status           ProjectStatus @default(ACTIVE)
  health           ProjectHealth @default(OPTIMAL)
  cluster          String        @default("us-east-metal")
  liveUrl          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lastDeployedAt   DateTime?

  // Relations
  members          ProjectMember[]
  agentRuns        AgentRun[]
  deployments      Deployment[]
  auditLogs        AuditLog[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([ownerId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(DEVELOPER)
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// -------------------------------------------------------------
// CONNECTED SERVICES & ENCRYPTED INTEGRATIONS
// -------------------------------------------------------------
model Integration {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  provider        IntegrationProvider
  name            String
  encryptedSecret String              // AES-256-GCM encrypted, never returned to browser
  keyHint         String?             // e.g. "sk-...ab12"
  status          IntegrationStatus   @default(ACTIVE)
  lastValidatedAt DateTime?
  configJson      String?             // Additional non-secret metadata
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([provider])
}

// -------------------------------------------------------------
// AUDIT LOGGING (SECURITY & COMPLIANCE)
// -------------------------------------------------------------
model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  details        String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// -------------------------------------------------------------
// AGENT COGNITIVE WORKFORCE
// -------------------------------------------------------------
model AgentRun {
  id              String      @id @default(cuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentName       String
  role            String
  taskTitle       String
  status          AgentStatus @default(RUNNING)
  model           String
  tokenUsage      Int         @default(0)
  toolsExecuted   Int         @default(0)
  durationSeconds Int         @default(0)
  currentAction   String?
  logsJson        String?     // Array of log strings in JSON
  startedAt       DateTime    @default(now())
  completedAt     DateTime?

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

// -------------------------------------------------------------
// DEPLOYMENTS
// -------------------------------------------------------------
model Deployment {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment String           @default("production")
  commitSha   String
  commitMsg   String
  status      DeploymentStatus @default(LIVE)
  latencyMs   Float            @default(1.2)
  region      String           @default("us-east-metal")
  liveUrl     String
  deployedAt  DateTime         @default(now())

  @@index([projectId])
  @@index([status])
}
