# =============================================================
# CRUCION Enterprise Engineering Ecosystem — Environment Config
# =============================================================

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Persistent Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crucion?schema=public"

# Session Secret (Generate with: openssl rand -base64 32)
# Required for signing JWT session cookies
SESSION_SECRET="your_production_session_secret_min_32_characters_long"

# Secret Encryption Key (AES-256-GCM) for third-party API keys
# Required for encrypting OpenAI, Anthropic, Gemini, GitHub tokens at rest
ENCRYPTION_SECRET="your_production_aes_256_encryption_secret_key"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telemetry & Security Configuration
CRUCION_CLUSTER_REGION="us-east-metal"
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ATTEMPTS=5
